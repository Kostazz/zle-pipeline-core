{
  "name": "zle-pipeline-core",
  "version": "0.1.0",
  "description": "Fail-closed TypeScript CLI pipeline core for ingest -> curate -> stage -> publish flows.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx src/index.ts ingest",
    "curate": "tsx src/index.ts curate",
    "stage": "tsx src/index.ts stage",
    "publish": "tsx src/index.ts publish",
    "demo": "bash examples/run.sh"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "fs-extra": "^11.3.0",
    "yargs": "^18.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.10",
    "@types/yargs": "^17.0.33",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
